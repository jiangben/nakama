    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Nakama",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "env": {
                "NAKAMA_DATA_DIR": "${workspaceFolder}/data",
                "NAKAMA_RUNTIME_PATH": "${workspaceFolder}/data/modules"
            },
            "args": [
                "--config",
                "${workspaceFolder}/local.yml",
            ]
        }
    ]
}